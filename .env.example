# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored - never commit real keys.
# ---------------------------------------------------------------------------

# --- Gemini (generates the reading) ---------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. gemini-2.5-flash is fast and cheap; gemini-2.5-pro reads deeper.
GEMINI_MODEL=gemini-2.5-flash
# 0 = stream immediately. Raise (e.g. 1024) for more considered readings.
GEMINI_THINKING_BUDGET=0

# --- Razorpay (pay as you wish) -------------------------------------------
# Dashboard > Account & Settings > API Keys. Use rzp_test_* keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Security --------------------------------------------------------------
# Signs the short-lived token that unlocks the reading after payment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# --- Meta ads --------------------------------------------------------------
# Your Meta Pixel ID. Leave blank and no pixel code is injected at all.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Local development only ------------------------------------------------
# true = skip Razorpay entirely so you can click through the whole funnel.
# MUST be removed or set to false in production.
ALLOW_TEST_PAYMENTS=false
